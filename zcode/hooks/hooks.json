{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|ApplyPatch",
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": ["${ZCODE_PLUGIN_ROOT}/bootstrap.py", "pre_tool_use"],
            "timeoutMs": 15000,
            "statusMessage": "DiffGuard 风险扫描"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": ["${ZCODE_PLUGIN_ROOT}/bootstrap.py", "ask_user_question"],
            "timeoutMs": 8000,
            "statusMessage": "DiffGuard 决策分析"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": ["${ZCODE_PLUGIN_ROOT}/bootstrap.py", "permission_request"],
            "timeoutMs": 10000,
            "statusMessage": "DiffGuard 权限审计"
          }
        ]
      }
    ]
  }
}
